    resources: tmpdir=/tmp
Shell command: 
        python /vsc-hard-mounts/leuven-data/373/vsc37390/ONT_cappable_seq/workflow/scripts/dedup_windows.py --fasta results/meme_training.fa --out results/motifs/LUZ7_US449_t5/meme_training_dedup.fa                --max-offset 15 2> results/motifs/LUZ7_US449_t5/logs/dedup_windows.log
        n=$(grep -c '>' results/motifs/LUZ7_US449_t5/meme_training_dedup.fa || true)
        if [ "$n" -ge 5 ]; then
            # windows are already oriented 5'->3' along the transcript,
            # so MEME searches the given strand only (no -revcomp)
            meme results/motifs/LUZ7_US449_t5/meme_training_dedup.fa -dna -oc results/motifs/LUZ7_US449_t5/meme -mod zoops                  -nmotifs 3 -minw 6 -maxw 20                  -bfile results/motifs/LUZ7_US449_t5/background_order2.txt -nostatus > results/motifs/LUZ7_US449_t5/logs/meme.log 2>&1
        else
            mkdir -p results/motifs/LUZ7_US449_t5/meme
            printf 'MEME version 5\n' > results/motifs/LUZ7_US449_t5/meme/meme.txt
            echo "only $n independent windows (< 5); discovery skipped" > results/motifs/LUZ7_US449_t5/logs/meme.log
        fi
        
